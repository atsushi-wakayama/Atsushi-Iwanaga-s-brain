{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mirai-wakayama-gikai (Next.js dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "mirai-wakayama-gikai"],
      "port": 3000
    },
    {
      "name": "mirai-wakayama-gikai-admin (Next.js dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "mirai-wakayama-gikai-admin"],
      "port": 3001
    },
    {
      "name": "kokkai-gian-ichiran (static site)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8743", "--directory", "kokkai-gian-ichiran"],
      "port": 8743
    }
  ]
}
